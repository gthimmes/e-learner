DATABASE_URL="file:./dev.db"
SESSION_SECRET="dev-only-change-me-in-production"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="200"
APP_URL="http://localhost:3000"
# SMTP_URL="smtp://user:pass@smtp.example.com:587"
# MAIL_FROM="e-learner <no-reply@example.com>"

# SSO (OpenID Connect). For local dev/tests: run `node scripts/mock-oidc.mjs`.
# OIDC_ISSUER="http://localhost:3400"
# OIDC_CLIENT_ID="e-learner"
# OIDC_CLIENT_SECRET=""
# OIDC_SCOPES="openid email profile"
# OIDC_ORG_SLUG=""
# OIDC_BUTTON_LABEL="Sign in with SSO"

# xAPI: forward statements to a Learning Record Store (optional)
# XAPI_LRS_URL="https://lrs.example.com/xapi"
# XAPI_LRS_AUTH="Basic base64(user:pass)"

# Payments (Stripe). Leave unset to use the in-app mock checkout.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."   # for POST /api/stripe/webhook
