DATABASE_URL="file:./dev.db"
SESSION_SECRET="dev-only-change-me-in-production"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="200"
APP_URL="http://localhost:3000"
# SMTP_URL="smtp://user:pass@smtp.example.com:587"
# MAIL_FROM="e-learner <no-reply@example.com>"

# SSO (OpenID Connect). For local dev/tests: run `node scripts/mock-oidc.mjs`.
# OIDC_ISSUER="http://localhost:3400"
# OIDC_CLIENT_ID="e-learner"
# OIDC_CLIENT_SECRET=""
# OIDC_SCOPES="openid email profile"
# OIDC_ORG_SLUG=""
# OIDC_BUTTON_LABEL="Sign in with SSO"

# xAPI: forward statements to a Learning Record Store (optional)
# XAPI_LRS_URL="https://lrs.example.com/xapi"
# XAPI_LRS_AUTH="Basic base64(user:pass)"

# Payments (Stripe). Leave unset to use the in-app mock checkout.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."   # for POST /api/stripe/webhook

# --- Operations (v1.4) ---
# Shared rate limits across instances (falls back to in-memory when unset)
# REDIS_URL="redis://localhost:6379"
# S3-compatible uploads (AWS S3, MinIO, R2). Unset = local disk at UPLOAD_DIR.
# S3_BUCKET="elearner"
# S3_REGION="us-east-1"
# S3_ENDPOINT="https://s3.us-east-1.amazonaws.com"   # MinIO: http://localhost:9000 + S3_FORCE_PATH_STYLE=1
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="0"
# S3_PUBLIC_URL=""            # CDN/public bucket base URL → /api/media redirects instead of proxying
# Webhook retry scheduler: POST /api/cron/webhooks with `Authorization: Bearer $CRON_SECRET`
# CRON_SECRET=""
# Error reporting: unhandled server errors are POSTed as JSON here (Sentry-compatible collector, Slack, …)
# ERROR_REPORT_URL=""
# LOG_LEVEL="info"            # debug | info | warn | error (JSON lines in production)
