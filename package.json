    "test:e2e": "playwright test",
    "webhooks:process": "tsx scripts/process-webhooks.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "ioredis": "^6.0.0",
